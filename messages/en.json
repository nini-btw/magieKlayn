  "faq": {
    "eyebrow": "Questions & Answers",
    "title": "Frequently Asked",
    "subtitle": "Everything you need to know about our mists, orders, and delivery. Can't find your answer? Reach out — we reply fast.",
    "contactCta": "Still have a question?",
    "contactButton": "Contact Us",
    "groups": {
      "top": {
        "label": "First Impressions",
        "sublabel": "Top Notes",
        "items": [
          {
            "q": "What is a scented mist, exactly?",
            "a": "A scented mist is a lightweight fragrance spray made for both body and hair. It's less concentrated than a traditional perfume, so it layers beautifully without overwhelming, and it's safe for daily use on hair."
          },
          {
            "q": "How many fragrances are in the collection?",
            "a": "Eleven mists, each built around a distinct mood and color. From the softest morning scents to bolder evening ones, there's a version of you in every bottle."
          },
          {
            "q": "How long does the scent last?",
            "a": "Most customers notice a soft, radiant trail for 4 to 6 hours, longer on hair than on skin. For best results, mist onto clean skin or slightly damp hair."
          }
        ]
      },
      "heart": {
        "label": "Orders & Delivery",
        "sublabel": "Heart Notes",
        "items": [
          {
            "q": "Which wilayas do you deliver to?",
            "a": "We deliver across all 58 wilayas via Stop Desk or Home Delivery. Available options are shown automatically at checkout based on your address."
          },
          {
            "q": "How long does delivery take?",
            "a": "Stop Desk orders typically arrive within 2 to 4 business days. Home delivery may take slightly longer depending on your area."
          },
          {
            "q": "Can I track my order?",
            "a": "Yes. Once your order ships, you'll receive tracking details by phone or email so you can follow it every step of the way."
          },
          {
            "q": "What payment methods do you accept?",
            "a": "We currently accept cash on delivery for all orders, with card payment coming soon."
          }
        ]
      },
      "base": {
        "label": "Care & Support",
        "sublabel": "Base Notes",
        "items": [
          {
            "q": "Can I build a custom box?",
            "a": "Yes. Use Build Your Box to select a size and mix any mists you like into one coffret, perfect for gifting or trying several at once."
          },
          {
            "q": "How should I store my mist?",
            "a": "Keep bottles away from direct sunlight and extreme heat. Stored properly, an unopened mist keeps its full character for up to 24 months."
          },
          {
            "q": "What if I'm not happy with my order?",
            "a": "Reach out within 7 days of delivery and our team will make it right, whether that's an exchange or support finding your match."
          }
        ]
      }
    }
  },
